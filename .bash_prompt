#!/usr/bin/env bash

# Shell prompt based on the Solarized Dark theme.
# Screenshot: http://i.imgur.com/EkEtphC.png
# Heavily inspired by @necolas’s prompt: https://github.com/necolas/dotfiles
# iTerm → Profiles → Text → use 13pt Monaco with 1.1 vertical spacing.
# Promote a bare `xterm` to its 256-colour variant. Guarded on `xterm`
# specifically: the old unguarded `elif` clobbered every $TERM, including
# `dumb` (emacs shell-mode) and terminals already reporting something richer.
if [[ $TERM = xterm ]]; then
	if [[ $COLORTERM = gnome-* ]] && infocmp gnome-256color >/dev/null 2>&1; then
		export TERM='gnome-256color';
	elif infocmp xterm-256color >/dev/null 2>&1; then
		export TERM='xterm-256color';
	fi;
fi;

prompt_git() {
	local s='' branchName='' gitDir='' line='';
	local staged='' unstaged='' untracked='' stashed='';

	# One rev-parse does double duty: it fails outside a repository (so we
	# return), and it reports where .git lives, which lets the stash check
	# below be a file test instead of another git invocation.
	gitDir="$(git rev-parse --git-dir 2>/dev/null)" || return;

	# `--porcelain --branch` reports branch, staged, unstaged and untracked
	# state in a SINGLE call. This used to be six separate git commands
	# (symbolic-ref, config, diff, diff-files, ls-files, rev-parse), costing
	# ~140ms on every prompt.
	while IFS= read -r line; do
		case "$line" in
			'## No commits yet on '*)
				branchName="${line#\#\# No commits yet on }" ;;
			'## HEAD '*)
				branchName='HEAD' ;; # detached; resolved below
			'## '*)
				branchName="${line#\#\# }";
				branchName="${branchName%%...*}" ;; # strip upstream + [ahead N]
			'??'*)
				untracked='?' ;;
			*)
				# XY status: X is the index column, Y the working tree.
				[ "${line:0:1}" != ' ' ] && staged='+';
				[ "${line:1:1}" != ' ' ] && unstaged='!' ;;
		esac;
	done < <(git status --porcelain --branch 2>/dev/null);

	# Detached HEAD: fall back to an exact tag, then a short SHA. Only pays for
	# the extra call in the rare detached case.
	if [ "$branchName" = 'HEAD' ]; then
		branchName="$(git describe --all --exact-match HEAD 2>/dev/null || \
			git rev-parse --short HEAD 2>/dev/null || \
			echo '(unknown)')";
	fi;

	# `git rev-parse --verify refs/stash` was one more subprocess; the ref is
	# just a file on disk.
	[ -f "${gitDir}/refs/stash" ] && stashed='$';

	s="${staged}${unstaged}${untracked}${stashed}";
	[ -n "${s}" ] && s=" [${s}]";

	echo -e "${1}${branchName}${2}${s}";
}

# The `tput setaf 1` probe stays -- it's how we detect 256-colour support -- but
# the values below are hardcoded rather than 14 more `tput` calls. Each was a
# subprocess, ~32ms of every shell's startup between them. The equivalent tput
# command is noted after each value. Bash expands these escapes in PS1, and
# prompt_git passes them through `echo -e`, so the \e form works in both places.
if tput setaf 1 &> /dev/null; then
	bold="\e[1m";          # tput bold
	reset="\e(B\e[m";      # tput sgr0
	# Solarized colors, taken from http://git.io/solarized-colors.
	black="\e[38;5;0m";    # tput setaf 0
	blue="\e[38;5;33m";    # tput setaf 33
	cyan="\e[38;5;37m";    # tput setaf 37
	green="\e[38;5;64m";   # tput setaf 64
	orange="\e[38;5;166m"; # tput setaf 166
	purple="\e[38;5;125m"; # tput setaf 125
	red="\e[38;5;124m";    # tput setaf 124
	violet="\e[38;5;61m";  # tput setaf 61
	white="\e[38;5;15m";   # tput setaf 15
	yellow="\e[38;5;136m"; # tput setaf 136
else
	bold='';
	reset="\e[0m";
	black="\e[1;30m";
	blue="\e[1;34m";
	cyan="\e[1;36m";
	green="\e[1;32m";
	orange="\e[1;33m";
	purple="\e[1;35m";
	red="\e[1;31m";
	violet="\e[1;35m";
	white="\e[1;37m";
	yellow="\e[1;33m";
fi;

# Highlight the user name when logged in as root.
if [[ "${USER}" == "root" ]]; then
	userStyle="${red}";
else
	userStyle="${orange}";
fi;

# Highlight the hostname when connected via SSH.
if [[ "${SSH_TTY}" ]]; then
	hostStyle="${bold}${red}";
else
	hostStyle="${yellow}";
fi;

# Set the terminal title and prompt.
#PS1="\[\033]0;\W\007\]"; # working directory base name
#PS1+="\[${bold}\]\n"; # newline
#PS1+="\[${userStyle}\]\u"; # username
#PS1+="\[${white}\]\w"; # working directory full path
#PS1+="\$(prompt_git \"\[${white}\] [${white}\]\" \"\[${blue}\]\"\\[${white}\]])"; # Git repository details
#PS1+="\[${white}\] $ \[${reset}\]"; # `$` (and reset color)
PS1="\[${green}\]\w"; # working directory full path
PS1+="\$(prompt_git \"\[${white}\] | \[${violet}\]\" \"\[${blue}\]\")"; # Git repository details
PS1+="\n";
PS1+="\[${white}\]\$ \[${reset}\]"; # `$` (and reset color)
export PS1;

PS2="\[${yellow}\]→ \[${reset}\]";
export PS2;
