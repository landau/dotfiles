# FFMPEG things
function ffmpeg_loop {
  ffmpeg -stream_loop $1 -i $2 -c copy $3
  #ffmpeg -stream_loop $1 -i $2 -vf "setpts=N/FRAME_RATE/TB" -c copy $3
}

function ffmpeg_merge {
  # don't create input file if it exists
  #if [ -f input.txt ]; then
    find *.mp4 | xargs -n1 -I{} echo "file {}" > input.txt;
  #fi
  ffmpeg -f concat -safe 0 -i input.txt -c copy $1.mp4;
}

function ffmpeg_125x {
  ffmpeg -i $1 -filter:v "setpts=0.8*PTS" -an $2
}

function ffmpeg_halfx {
  ffmpeg -i $1 -filter:v "setpts=1.25*PTS" -an $2
}

# ---

function save_chrome_tabs() {
    osascript <<EOF
    -- Save all open Chrome tabs to text files
    tell application "Google Chrome"
        set windowCount to count windows
        repeat with i from 1 to windowCount
            set tabData to ""
            set theWindow to window i
            set tabCount to count tabs of theWindow
            
            -- Iterate over each tab in the window
            repeat with j from 1 to tabCount
                set theTab to tab j of theWindow
                set tabTitle to title of theTab
                set tabURL to URL of theTab
                set tabData to tabData & tabTitle & " - " & tabURL & linefeed
            end repeat
            
            -- Write tab data to a file
            set fileName to "chrome_tabs_" & i & ".txt"
            set desktopPath to POSIX file (POSIX path of (path to desktop)) as text
            set filePath to desktopPath & fileName
            set fileID to open for access file filePath with write permission
            try
                set eof fileID to 0
                write tabData to fileID
            on error errMsg
                display dialog "Error writing file: " & errMsg
            end try
            close access fileID
        end repeat
    end tell
EOF
}


function bash_urlencode() {
  local str="$1"
  local encoded=""
  for (( i=0; i<${#str}; i++ )); do
    local c="${str:i:1}"
    case "$c" in
      [a-zA-Z0-9.~_-]) encoded+="$c" ;;
      " ") encoded+="+"
          ;;
      *) encoded+=$(printf '%%%02X' "'$c") ;;
    esac
  done
  echo "$encoded"
}

function quotes ()
{
# Get the command line arguments
  q=$(printf "%s" "$1" | jq -s -R -r @uri)
page=$2

# Construct the URL
url="https://www.goodreads.com/quotes/search?commit=Search&page=$page&q=$q"

# Fetch the page content
content=$(curl -s "$url")

  # Parse out each quote and related author
  quotes=$(echo "$content" | xmllint --html --xpath '//div[@class="quoteText"]' - 2>/dev/null | sed -e 's/<[^>]*>//g' -e 's/^[ \t]*//;s/[ \t]*$//' -e 's/&ldquo;//g' -e 's/&rdquo;//g' -e 's/&mdash;/--/g')
   authors=$(echo "$content" | xmllint --html --xpath '//span[@class="authorOrTitle"]/text()' - 2>/dev/null | sed 's/^[ \t]*//;s/[ \t]*$//' | awk -F', <span id="quote_book_link_"' '{print $1}') 

  # Combine quotes and authors into an array
  IFS=$'\n' read -r -d '' -a quotes_array <<< "$quotes"
  IFS=$'\n' read -r -d '' -a authors_array <<< "$authors"

  # Print each quote and related author
  for i in "${!quotes[@]}"; do
    echo "Quote: ${quotes[$i]} ${authors[$i]}"
    echo
  done
}

