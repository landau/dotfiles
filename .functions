function get_bundle_version {
  # TODO: remove whitespace
  grep -A 1 "BUNDLED WITH" Gemfile.lock | tail -n 1
}

function bundle_install {
  bundle "_$(get_bundle_version)_" install
}

print_wiki_pod_url () {
    YEAR=${1:-$(date "+%Y")}
    MONTH=${2:-$(date "+%m")}
    DAY=${3:-$(date "+%d")}
    curl -s "https://api.wikimedia.org/feed/v1/wikipedia/en/featured/$YEAR/$MONTH/$DAY" | jq '.image.image.source'
}

# Downloads wikimedea picture of the day into the ~/Pictures/wiki dir 
# named YYYY-MM-DD.jpg
dl_wiki_pod () {
    # Forward all given arguments ($@) to print_wiki_pod_url
    FILENAME="${1:-$(date +%Y)}-${2:-$(date +%m)}-${3:-$(date +%d)}.jpg"
    print_wiki_pod_url "$@" | xargs curl -s -o "$HOME/Pictures/wiki/$FILENAME"
}


