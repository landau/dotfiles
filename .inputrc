# Make Tab autocomplete regardless of filename case
set completion-ignore-case on

# List all matches in case multiple possible completions are possible
set show-all-if-ambiguous on

# Immediately add a trailing slash when autocompleting symlinks to directories
set mark-symlinked-directories on

# Use the text that has already been typed as the prefix for searching through
# commands (i.e. more intelligent Up/Down behavior)
"\e[B": history-search-forward
"\e[A": history-search-backward

# Do not autocomplete hidden files unless the pattern explicitly begins with a dot
set match-hidden-files off

# Show all autocomplete results at once
set page-completions off

# If there are more than 200 possible completions for a word, ask to show them all
set completion-query-items 200

# Show extra file information when completing, like `ls -F` does
set visible-stats on

# Be more intelligent when autocompleting by also looking at the text after
# the cursor. For example, when the current line is "cd ~/src/mozil", and
# the cursor is on the "z", pressing Tab will not autocomplete it to "cd
# ~/src/mozillail", but to "cd ~/src/mozilla". (This is supported by the
# Readline used by Bash 4.)
#
# History: this was inert under Apple's /bin/bash 3.2.57, whose Readline
# predates the variable -- and Readline ignores unknown `set` names silently,
# so it looked fine. Live since 2026-08-18, when the login shell became
# brew's bash 5.3.15 (`chsh -s /opt/homebrew/bin/bash`). Reverting the login
# shell to /bin/bash makes this, and the two `colored-*` settings below, quietly
# stop working again.
set skip-completed-text on

# Colourise completion listings by file type, and highlight the matched prefix.
# Both need Readline 6+/8.1+ respectively, so both require the brew bash noted
# above -- inert on Apple's 3.2.
set colored-stats on
set colored-completion-prefix on

# Allow UTF-8 input and output, instead of showing stuff like $'\0123\0456'
set input-meta on
set output-meta on
set convert-meta off

# Use Alt/Meta + Delete to delete the preceding word
"\e[3;3~": kill-word

# Don't beep on an ambiguous completion (readline defaults to `audible`).
set bell-style none

# With show-all-if-ambiguous above, list the matches immediately when Tab can't
# insert anything, rather than requiring a second Tab.
set show-all-if-unmodified on

# Keep the cursor where it was when walking history, instead of jumping to
# end-of-line on every entry. Matters because Up/Down are bound to prefix
# search above, so history is walked mid-line.
set history-preserve-point on

# Word-wise movement on Ctrl/Alt + arrows. Only \eb and \ef (Alt-b/Alt-f) were
# bound; the arrow combos were unbound entirely. iTerm sends xterm-style
# modifiers -- ;2 Shift, ;3 Alt, ;5 Ctrl -- as the kill-word binding above
# already relies on. To check a key's sequence, press Ctrl-V then the key.
"\e[1;5D": backward-word  # Ctrl+Left
"\e[1;5C": forward-word   # Ctrl+Right
"\e[1;3D": backward-word  # Alt+Left
"\e[1;3C": forward-word   # Alt+Right
